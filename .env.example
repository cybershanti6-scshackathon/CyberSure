# ---------------------------------------------------------------------------------
# CYBERSURE environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------------

# ---- Backend (FastAPI) ------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# If unset, the backend trusts local dev origins plus the production frontend
# (https://cybersure.vercel.app). Set it explicitly in production, e.g.:
#   Production (Render/Railway/etc.):
#     CYBERSURE_CORS_ORIGINS=https://cybersure.vercel.app
#   Local development:
#     CYBERSURE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Never use a wildcard (`*`) for remote origins.
CYBERSURE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://cybersure.vercel.app

# Set to `true` only if you need cookie-based auth during development.
CYBERSURE_CORS_CREDENTIALS=true

# Origins matched by pattern, in addition to the exact list above.
#
# The default trusts ANY port on loopback (localhost / 127.0.0.1 / [::1]), http
# or https. This matters because a dev server picks its own port: if 5173 is
# busy, Vite moves to 5174, 5175, ... A fixed port list would then reject the
# app's own origin, and the browser would block every request - which surfaces
# as "the conversion service is not responding" even though the backend is
# perfectly healthy.
#
# Loopback origins can only be your own machine, so this is not the same risk as
# a wildcard. To lock it down, set an explicit pattern or clear it entirely:
#   CYBERSURE_CORS_ORIGIN_REGEX=^https?://localhost:5173$
#   CYBERSURE_CORS_ORIGIN_REGEX=
CYBERSURE_CORS_ORIGIN_REGEX=

# Maximum accepted configuration upload size in bytes (default 4 MiB).
CYBERSURE_MAX_UPLOAD_BYTES=4194304

# Accepted configuration file extensions.
CYBERSURE_ALLOWED_UPLOAD_EXTENSIONS=.cfg,.conf,.txt,.rsc,.ios,.junos,.config,.rcf

# How many generated conversion reports to keep in memory.
CYBERSURE_MAX_REPORTS=100

# ---- Frontend (Vite / React) ------------------------------------------------------
# Base URL of the FastAPI backend. The browser talks to this directly, so it must
# be reachable from the machine running the frontend and CORS-enabled above.
#
# LOCAL development (this file, gitignored):
VITE_API_BASE_URL=http://localhost:8000
#
# PRODUCTION (Vercel dashboard -> Settings -> Environment Variables ->
# Environment = Production) must hold the PUBLIC HTTPS backend URL instead:
#   VITE_API_BASE_URL=https://<public-fastapi-backend>
# Vite inlines VITE_* values at build time, so after changing the variable the
# Vercel deployment must be rebuilt/redeployed. Vercel-provided environment
# variables take precedence over this .env file during Vercel builds.

# Optional request timeout in milliseconds.
VITE_API_TIMEOUT_MS=30000

# ---- Optional: AI provider --------------------------------------------------------
# The assistant is local and rule-based today. If you later add a hosted model,
# put the key here and proxy every call through the backend. Never put it in
# frontend source, and never send it as VITE_* (those are public at build time).
# CYBERSURE_AI_API_KEY=
# CYBERSURE_AI_MODEL=
