# Production build defaults for Vite (mode=production).
#
# In the merged single-service deployment, the React frontend and the FastAPI
# backend are served from the SAME origin (e.g. https://cybersure.onrender.com).
# Setting VITE_API_BASE_URL to an empty string makes every fetch() call use a
# relative URL (/api/v1/health, /api/v1/conversions, etc.) — the browser
# resolves them against window.location.origin automatically.
#
# Local development is unaffected: the .env file (gitignored) sets
#   VITE_API_BASE_URL=http://localhost:8000
# which overrides this file.
VITE_API_BASE_URL=

VITE_API_TIMEOUT_MS=30000
