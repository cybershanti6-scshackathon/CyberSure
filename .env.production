# Production build defaults for Vite (mode=production).
#
# The frontend and backend are served from the SAME origin in production,
# so API calls use relative URLs (/api/v1/...) — no base URL needed.
#
# VITE_API_BASE_URL="" → api.ts uses '' → fetch('/api/v1/health') resolves
# against window.location.origin automatically.
#
# Local dev: .env (gitignored) still sets VITE_API_BASE_URL=http://localhost:8000
# OR Vite's server.proxy in vite.config.ts forwards /api → localhost:8000.
VITE_API_BASE_URL=

VITE_API_TIMEOUT_MS=30000
