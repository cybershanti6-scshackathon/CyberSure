# Production build defaults for Vite (mode=production).
#
# A real environment variable always wins over this file, so a VITE_API_BASE_URL
# set in a hosting dashboard (Vercel / Render) takes precedence. This file exists
# so production builds get a reasonable value with NO dashboard configuration.
#
# IMPORTANT: VITE_* values are inlined into the JS bundle at build time.
# After changing VITE_API_BASE_URL you MUST redeploy (or trigger a new build)
# — the running frontend will keep using the old value until then.
#
# Set this to your deployed backend URL, e.g.:
#   https://cybersure-api.onrender.com   (Render backend service)
#   https://your-backend.railway.app     (Railway, etc.)
#
# Never set this to the frontend URL (https://cybersure.vercel.app) — that is
# the React app, not the FastAPI API.
VITE_API_BASE_URL=https://cybersure-api.onrender.com

VITE_API_TIMEOUT_MS=30000
