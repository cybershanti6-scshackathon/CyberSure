# Production build defaults for Vite (mode=production).
#
# A real environment variable always wins over this file, so a VITE_API_BASE_URL
# set in a hosting dashboard (Vercel/Render) takes precedence. This file exists
# so production builds get the right value with NO dashboard configuration.
#
# The conversion API is served by this same deployment under /api/v1 - see
# api/index.py and the rewrite in vercel.json. The Render-hosted frontend
# (https://cybersure-7g67.onrender.com) calls it cross-origin; that origin is
# in the backend's default CORS list (backend/app/core/config.py).
VITE_API_BASE_URL=https://cybersure.vercel.app
